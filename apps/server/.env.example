DATABASE_URL=mysql://root:root@localhost:3306/capyberries
PORT=3000
# Base URL of the web app used in bot /login links
SITE_URL=http://localhost:5173
# Lifetime of one-time login tokens from /login, seconds
AUTH_TOKEN_TTL_SECONDS=600
# Reject non-mobile visitors on /auth and the SPA (enable in production)
MOBILE_ONLY=false

# Telegram bot (from @BotFather)
BOT_TOKEN=
# Any random string [A-Za-z0-9_-], up to 256 chars, e.g. output of: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Public https URL of this server, no trailing slash, e.g. https://appdomain.com
BOT_WEBHOOK_URL=
# Optional: http(s)-proxy for outgoing calls to api.telegram.org (local dev when blocked)
TELEGRAM_PROXY_URL=
