{
  "name": "capyberries",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"bun run --filter '@capyberries/server' dev\" \"bun run --filter '@capyberries/web' dev\"",
    "build": "bun run --filter '@capyberries/web' build",
    "start": "bun run --filter '@capyberries/server' start",
    "db:generate": "bun run --filter '@capyberries/server' db:generate",
    "db:migrate": "bun run --filter '@capyberries/server' db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
